{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cambrian.local/schemas/evolution_review_decision_v0_1.schema.json",
  "title": "Evolution Review Decision v0.1",
  "description": "evolution_suggestion_v0_1을 사용자가 검토한 승인/거절 기록 계약이다. 이 계약은 pack을 자동 수정하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "decision_kind",
    "generated_by",
    "generated_at",
    "source_suggestion",
    "review_status",
    "approval_gate",
    "proof_boundary",
    "privacy",
    "decisions",
    "next_step",
    "rollback"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://cambrian.local/schemas/evolution_review_decision_v0_1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "decision_kind": {
      "type": "string",
      "const": "evolution_review_decision_v0_1"
    },
    "generated_by": {
      "type": "string",
      "const": "web/evolution/index.html"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestion_kind",
        "agent_id",
        "proposal_status",
        "recommendation_count",
        "recommendation_ids",
        "source_receipt_eligible_for_suggestion",
        "source_receipt_requires_user_approval"
      ],
      "properties": {
        "suggestion_kind": {
          "type": "string",
          "const": "evolution_suggestion_v0_1"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "proposal_status": {
          "type": "string",
          "const": "draft_requires_user_approval"
        },
        "recommendation_count": {
          "type": "integer",
          "minimum": 1
        },
        "recommendation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          }
        },
        "source_receipt_eligible_for_suggestion": {
          "type": "boolean",
          "const": true
        },
        "source_receipt_requires_user_approval": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "review_status": {
      "type": "string",
      "const": "reviewed_not_applied"
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_reviewed",
        "auto_apply",
        "auto_promote",
        "apply_requires_separate_step",
        "can_create_new_version"
      ],
      "properties": {
        "user_reviewed": {
          "type": "boolean",
          "const": true
        },
        "auto_apply": {
          "type": "boolean",
          "const": false
        },
        "auto_promote": {
          "type": "boolean",
          "const": false
        },
        "apply_requires_separate_step": {
          "type": "boolean",
          "const": true
        },
        "can_create_new_version": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_runtime_evidence",
        "proof_claim_allowed",
        "success_rate_claim_allowed",
        "marketplace_sale_ready"
      ],
      "properties": {
        "uses_runtime_evidence": {
          "type": "boolean",
          "const": false
        },
        "proof_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "success_rate_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "marketplace_sale_ready": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stores_raw_inputs",
        "stores_raw_outputs",
        "stores_secrets",
        "uses_only_suggestion_metadata"
      ],
      "properties": {
        "stores_raw_inputs": {
          "type": "boolean",
          "const": false
        },
        "stores_raw_outputs": {
          "type": "boolean",
          "const": false
        },
        "stores_secrets": {
          "type": "boolean",
          "const": false
        },
        "uses_only_suggestion_metadata": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recommendation_id",
          "target",
          "decision",
          "reviewer_note",
          "risk_level"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^decision_[0-9]+$"
          },
          "recommendation_id": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          },
          "target": {
            "type": "string",
            "enum": [
              "instructions.md",
              "agent.json.validation_criteria",
              "agent.json.known_limits",
              "agent_card.json"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "deferred"
            ]
          },
          "reviewer_note": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium"
            ]
          }
        }
      }
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "blocked"
      ],
      "properties": {
        "allowed": {
          "type": "string",
          "const": "generate_candidate_pack_after_user_command"
        },
        "blocked": {
          "type": "string",
          "const": "automatic_pack_mutation"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_apply",
        "strategy"
      ],
      "properties": {
        "required_before_apply": {
          "type": "boolean",
          "const": true
        },
        "strategy": {
          "type": "string",
          "const": "save_previous_agent_pack_before_new_version"
        }
      }
    }
  }
}
