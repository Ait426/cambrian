{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cambrian.local/schemas/agent_pack_bundle_v0_1.schema.json",
  "title": "Agent Pack Bundle v0.1",
  "description": "플랫폼-first Builder가 내려받는 .agent-pack.json 전체 번들 계약이다.",
  "x-required_preflight_checks": [
    "required_files_present",
    "manifest_agent_id_matches_contract",
    "risk_report_matches_contract",
    "secret_collection_forbidden",
    "preflight_validator_matches",
    "preflight_agent_id_matches_contract",
    "preflight_risk_matches_contract",
    "agent_card_matches_contract",
    "agent_card_private_preview",
    "marketplace_review_matches_card",
    "marketplace_review_not_ready",
    "private_by_default",
    "sale_not_ready",
    "proof_claim_blocked",
    "cambrian_not_required",
    "legal_notice_names_no_runtime_evidence",
    "runner_names_cambrian_optional",
    "runner_names_manual_runner",
    "preflight_status_matches_risk",
    "preflight_evidence_status_matches_manifest"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "bundle_schema",
    "schema_version",
    "package_kind",
    "generated_by",
    "platform_track",
    "files",
    "riskReport"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "generated_by": {
            "const": "tools/generate_candidate_pack.py"
          }
        }
      },
      "then": {
        "required": [
          "candidate_metadata"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "generated_by": {
            "const": "tools/generate_candidate_pack.py"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "promotion_metadata"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "generated_by": {
            "const": "tools/promote_candidate_pack.py"
          }
        }
      },
      "then": {
        "required": [
          "promotion_metadata"
        ],
        "not": {
          "required": [
            "candidate_metadata"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "generated_by": {
            "const": "web/platform/index.html"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "candidate_metadata"
              ]
            }
          },
          {
            "not": {
              "required": [
                "promotion_metadata"
              ]
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://cambrian.local/schemas/agent_pack_bundle_v0_1.schema.json"
    },
    "bundle_schema": {
      "type": "string",
      "const": "agent_pack_bundle_v0_1"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "package_kind": {
      "type": "string",
      "const": "agent_pack_bundle"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "web/platform/index.html",
        "tools/generate_candidate_pack.py",
        "tools/promote_candidate_pack.py"
      ]
    },
    "platform_track": {
      "type": "string",
      "const": "platform-first"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent.json",
        "agent_card.json",
        "instructions.md",
        "run_local.md",
        "legal_notice.md",
        "preflight_report.json",
        "marketplace_review.json",
        "manifest.json"
      ],
      "properties": {
        "agent.json": {
          "type": "object"
        },
        "agent_card.json": {
          "$ref": "#/$defs/agent_card"
        },
        "instructions.md": {
          "type": "string",
          "minLength": 1
        },
        "run_local.md": {
          "type": "string",
          "minLength": 1
        },
        "legal_notice.md": {
          "type": "string",
          "minLength": 1
        },
        "preflight_report.json": {
          "$ref": "#/$defs/preflight_report"
        },
        "marketplace_review.json": {
          "$ref": "#/$defs/marketplace_review"
        },
        "manifest.json": {
          "$ref": "#/$defs/manifest"
        }
      }
    },
    "riskReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "warnings",
        "blocks",
        "no_runtime_evidence"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "Green",
            "Yellow",
            "Red"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_runtime_evidence": {
          "type": "string",
          "const": "실제 성공률은 실행 데이터가 생긴 뒤에만 표시"
        }
      }
    },
    "candidate_metadata": {
      "$ref": "#/$defs/candidate_metadata"
    },
    "promotion_metadata": {
      "$ref": "#/$defs/promotion_metadata"
    }
  },
  "$defs": {
    "candidate_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_kind",
        "source_suggestion_kind",
        "source_decision_kind",
        "apply_status",
        "auto_apply",
        "auto_promote",
        "approved_decision_ids",
        "approved_recommendation_ids",
        "deferred_recommendation_ids",
        "rejected_recommendation_ids",
        "requires_user_final_review",
        "original_pack_preserved",
        "generated_at"
      ],
      "properties": {
        "metadata_kind": {
          "type": "string",
          "const": "candidate_agent_pack_metadata_v0_1"
        },
        "source_suggestion_kind": {
          "type": "string",
          "const": "evolution_suggestion_v0_1"
        },
        "source_decision_kind": {
          "type": "string",
          "const": "evolution_review_decision_v0_1"
        },
        "apply_status": {
          "type": "string",
          "const": "candidate_not_applied"
        },
        "auto_apply": {
          "type": "boolean",
          "const": false
        },
        "auto_promote": {
          "type": "boolean",
          "const": false
        },
        "approved_decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^decision_[0-9]+$"
          }
        },
        "approved_recommendation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          }
        },
        "deferred_recommendation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          }
        },
        "rejected_recommendation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          }
        },
        "requires_user_final_review": {
          "type": "boolean",
          "const": true
        },
        "original_pack_preserved": {
          "type": "boolean",
          "const": true
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "promotion_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_kind",
        "source_candidate_metadata_kind",
        "source_candidate_generated_by",
        "source_diff_report_kind",
        "source_diff_report_generated_by",
        "promotion_status",
        "candidate_apply_status_before_promotion",
        "user_command_required",
        "auto_promote",
        "approved_decision_ids",
        "approved_recommendation_ids",
        "original_pack_preserved",
        "candidate_pack_preserved",
        "proof_claim_allowed",
        "marketplace_sale_ready",
        "promoted_from_candidate_hash",
        "diff_report_hash",
        "generated_at"
      ],
      "properties": {
        "metadata_kind": {
          "type": "string",
          "const": "promoted_agent_pack_metadata_v0_1"
        },
        "source_candidate_metadata_kind": {
          "type": "string",
          "const": "candidate_agent_pack_metadata_v0_1"
        },
        "source_candidate_generated_by": {
          "type": "string",
          "const": "tools/generate_candidate_pack.py"
        },
        "source_diff_report_kind": {
          "type": "string",
          "const": "candidate_diff_report_v0_1"
        },
        "source_diff_report_generated_by": {
          "type": "string",
          "const": "tools/generate_candidate_diff_report.py"
        },
        "promotion_status": {
          "type": "string",
          "const": "promoted_private_version"
        },
        "candidate_apply_status_before_promotion": {
          "type": "string",
          "const": "candidate_not_applied"
        },
        "user_command_required": {
          "type": "boolean",
          "const": true
        },
        "auto_promote": {
          "type": "boolean",
          "const": false
        },
        "approved_decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^decision_[0-9]+$"
          }
        },
        "approved_recommendation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          }
        },
        "original_pack_preserved": {
          "type": "boolean",
          "const": true
        },
        "candidate_pack_preserved": {
          "type": "boolean",
          "const": true
        },
        "proof_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "marketplace_sale_ready": {
          "type": "boolean",
          "const": false
        },
        "promoted_from_candidate_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "diff_report_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "agent_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "card_kind",
        "agent_id",
        "name",
        "template_id",
        "summary",
        "capabilities",
        "risk_level",
        "preflight_status",
        "evidence_status",
        "marketplace",
        "known_limits"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "card_kind": {
          "type": "string",
          "const": "private_agent_card"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "template_id": {
          "type": "string",
          "enum": [
            "document_organizer",
            "meeting_notes",
            "email_draft",
            "checklist_maker"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "preflight_status": {
          "type": "string",
          "enum": [
            "pass",
            "blocked",
            "fail"
          ]
        },
        "evidence_status": {
          "type": "string",
          "const": "no_runtime_evidence"
        },
        "marketplace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "sale_ready",
            "proof_claim_allowed"
          ],
          "properties": {
            "visibility": {
              "type": "string",
              "const": "private"
            },
            "sale_ready": {
              "type": "boolean",
              "const": false
            },
            "proof_claim_allowed": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_kind",
        "bundle_schema",
        "agent_contract_schema",
        "schema_ref",
        "files",
        "entrypoint",
        "agent_id",
        "risk_level",
        "runtime",
        "evidence_status",
        "marketplace"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "package_kind": {
          "type": "string",
          "const": "agent_pack_bundle"
        },
        "bundle_schema": {
          "type": "string",
          "const": "agent_pack_bundle_v0_1"
        },
        "agent_contract_schema": {
          "type": "string",
          "const": "agent_contract_v0_1"
        },
        "schema_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle",
            "agent_contract"
          ],
          "properties": {
            "bundle": {
              "type": "string",
              "const": "schemas/agent_pack_bundle_v0_1.schema.json"
            },
            "agent_contract": {
              "type": "string",
              "const": "schemas/agent_contract_v0_1.schema.json"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "agent.json"
              }
            },
            {
              "contains": {
                "const": "agent_card.json"
              }
            },
            {
              "contains": {
                "const": "instructions.md"
              }
            },
            {
              "contains": {
                "const": "run_local.md"
              }
            },
            {
              "contains": {
                "const": "legal_notice.md"
              }
            },
            {
              "contains": {
                "const": "preflight_report.json"
              }
            },
            {
              "contains": {
                "const": "marketplace_review.json"
              }
            },
            {
              "contains": {
                "const": "manifest.json"
              }
            }
          ],
          "items": {
            "type": "string"
          }
        },
        "entrypoint": {
          "type": "string",
          "const": "instructions.md"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "Green",
            "Yellow",
            "Red"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cambrian_required",
            "cambrian_compatible"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "generic"
            },
            "cambrian_required": {
              "type": "boolean",
              "const": false
            },
            "cambrian_compatible": {
              "type": "string",
              "enum": [
                "planned",
                "supported"
              ]
            }
          }
        },
        "evidence_status": {
          "type": "string",
          "const": "no_runtime_evidence"
        },
        "marketplace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "public_listing_allowed",
            "sale_ready",
            "proof_claim_allowed"
          ],
          "properties": {
            "visibility": {
              "type": "string",
              "const": "private"
            },
            "public_listing_allowed": {
              "type": "boolean",
              "const": false
            },
            "sale_ready": {
              "type": "boolean",
              "const": false
            },
            "proof_claim_allowed": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },
    "marketplace_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "review_kind",
        "status",
        "agent_id",
        "listing_visibility",
        "sale_ready",
        "proof_claim_allowed",
        "reasons",
        "required_before_public_listing"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "review_kind": {
          "type": "string",
          "const": "private_marketplace_review"
        },
        "status": {
          "type": "string",
          "const": "not_ready"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "listing_visibility": {
          "type": "string",
          "const": "private"
        },
        "sale_ready": {
          "type": "boolean",
          "const": false
        },
        "proof_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_before_public_listing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preflight_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "validator",
        "status",
        "agent_id",
        "risk_level",
        "evidence_status",
        "checks",
        "warnings",
        "errors"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "validator": {
          "type": "string",
          "const": "agent_pack_preflight_v0_1"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "blocked",
            "fail"
          ]
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "evidence_status": {
          "type": "string",
          "const": "no_runtime_evidence"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/preflight_check"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_issue"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_issue"
          }
        }
      }
    },
    "preflight_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "message"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preflight_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
