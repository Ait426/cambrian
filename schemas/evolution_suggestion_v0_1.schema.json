{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cambrian.local/schemas/evolution_suggestion_v0_1.schema.json",
  "title": "Evolution Suggestion v0.1",
  "description": "manual run receipt와 agent pack을 바탕으로 만든 진화 제안 초안 계약이다. 이 계약은 자동 적용이나 proof가 아니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "suggestion_kind",
    "generated_by",
    "generated_at",
    "source_agent",
    "source_receipt",
    "proposal_status",
    "approval_gate",
    "proof_boundary",
    "privacy",
    "recommendations",
    "rollback"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://cambrian.local/schemas/evolution_suggestion_v0_1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "suggestion_kind": {
      "type": "string",
      "const": "evolution_suggestion_v0_1"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "tools/generate_evolution_suggestion.py",
        "web/runner/index.html"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_name",
        "bundle_schema",
        "risk_level"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "agent_name": {
          "type": "string",
          "minLength": 1
        },
        "bundle_schema": {
          "type": "string",
          "const": "agent_pack_bundle_v0_1"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "green",
            "yellow"
          ]
        }
      }
    },
    "source_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_kind",
        "runner_mode",
        "run_status",
        "result_status",
        "input_length",
        "output_length",
        "manual_check_count",
        "eligible_for_suggestion",
        "requires_user_approval"
      ],
      "properties": {
        "receipt_kind": {
          "type": "string",
          "const": "manual_run_receipt_v0_1"
        },
        "runner_mode": {
          "type": "string",
          "const": "manual_no_api"
        },
        "run_status": {
          "type": "string",
          "const": "manual_review_only"
        },
        "result_status": {
          "type": "string",
          "enum": [
            "result_pasted_for_manual_review",
            "result_not_recorded"
          ]
        },
        "input_length": {
          "type": "integer",
          "minimum": 0
        },
        "output_length": {
          "type": "integer",
          "minimum": 0
        },
        "manual_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_for_suggestion": {
          "type": "boolean",
          "const": true
        },
        "requires_user_approval": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proposal_status": {
      "type": "string",
      "const": "draft_requires_user_approval"
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_user_approval",
        "auto_apply",
        "auto_promote",
        "can_create_new_version"
      ],
      "properties": {
        "requires_user_approval": {
          "type": "boolean",
          "const": true
        },
        "auto_apply": {
          "type": "boolean",
          "const": false
        },
        "auto_promote": {
          "type": "boolean",
          "const": false
        },
        "can_create_new_version": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_runtime_evidence",
        "proof_claim_allowed",
        "success_rate_claim_allowed",
        "marketplace_sale_ready"
      ],
      "properties": {
        "uses_runtime_evidence": {
          "type": "boolean",
          "const": false
        },
        "proof_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "success_rate_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "marketplace_sale_ready": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stores_raw_inputs",
        "stores_raw_outputs",
        "stores_secrets",
        "uses_only_receipt_metadata"
      ],
      "properties": {
        "stores_raw_inputs": {
          "type": "boolean",
          "const": false
        },
        "stores_raw_outputs": {
          "type": "boolean",
          "const": false
        },
        "stores_secrets": {
          "type": "boolean",
          "const": false
        },
        "uses_only_receipt_metadata": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "target",
          "rationale",
          "proposed_change",
          "risk_level",
          "acceptance_criteria",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "enum": [
              "instructions.md",
              "agent.json.validation_criteria",
              "agent.json.known_limits",
              "agent_card.json"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "proposed_change": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium"
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "const": "suggested"
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_apply",
        "strategy"
      ],
      "properties": {
        "required_before_apply": {
          "type": "boolean",
          "const": true
        },
        "strategy": {
          "type": "string",
          "const": "save_previous_agent_pack_before_new_version"
        }
      }
    }
  }
}
