{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cambrian.local/schemas/candidate_diff_report_v0_1.schema.json",
  "title": "Candidate Diff Report v0.1",
  "description": "원본 agent pack과 candidate pack의 차이가 승인된 진화 결정 안에 머무는지 검토하는 diff 계약이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "report_kind",
    "generated_by",
    "generated_at",
    "source",
    "diff_status",
    "comparison",
    "approval_gate",
    "proof_boundary",
    "change_summary",
    "allowed_changes",
    "unexpected_changes",
    "next_step"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://cambrian.local/schemas/candidate_diff_report_v0_1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "report_kind": {
      "type": "string",
      "const": "candidate_diff_report_v0_1"
    },
    "generated_by": {
      "type": "string",
      "const": "tools/generate_candidate_diff_report.py"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "original_pack_hash",
        "candidate_pack_hash",
        "decision_kind",
        "decision_review_status"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "original_pack_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidate_pack_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decision_kind": {
          "type": "string",
          "const": "evolution_review_decision_v0_1"
        },
        "decision_review_status": {
          "type": "string",
          "const": "reviewed_not_applied"
        }
      }
    },
    "diff_status": {
      "type": "string",
      "enum": [
        "review_pass_not_promoted",
        "review_fail"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id_matches",
        "original_pack_valid",
        "candidate_pack_valid",
        "candidate_is_distinct",
        "only_approved_decisions_applied",
        "deferred_and_rejected_not_applied"
      ],
      "properties": {
        "agent_id_matches": {
          "type": "boolean",
          "const": true
        },
        "original_pack_valid": {
          "type": "boolean",
          "const": true
        },
        "candidate_pack_valid": {
          "type": "boolean",
          "const": true
        },
        "candidate_is_distinct": {
          "type": "boolean",
          "const": true
        },
        "only_approved_decisions_applied": {
          "type": "boolean",
          "const": true
        },
        "deferred_and_rejected_not_applied": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_promote",
        "candidate_review_required",
        "promotion_requires_separate_command"
      ],
      "properties": {
        "auto_promote": {
          "type": "boolean",
          "const": false
        },
        "candidate_review_required": {
          "type": "boolean",
          "const": true
        },
        "promotion_requires_separate_command": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_runtime_evidence",
        "proof_claim_allowed",
        "success_rate_claim_allowed",
        "marketplace_sale_ready"
      ],
      "properties": {
        "uses_runtime_evidence": {
          "type": "boolean",
          "const": false
        },
        "proof_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "success_rate_claim_allowed": {
          "type": "boolean",
          "const": false
        },
        "marketplace_sale_ready": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "change_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_path_count",
        "changed_files",
        "approved_decision_ids",
        "deferred_or_rejected_decision_ids"
      ],
      "properties": {
        "changed_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "approved_decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          },
          "uniqueItems": true
        },
        "deferred_or_rejected_decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evo_[0-9]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "allowed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change_type",
          "source_decision_id",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change_type": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "source_decision_id": {
            "type": "string",
            "pattern": "^(evo_[0-9]+|candidate_metadata)$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unexpected_changes": {
      "type": "array",
      "maxItems": 0
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "blocked"
      ],
      "properties": {
        "allowed": {
          "type": "string",
          "const": "promote_candidate_after_user_command"
        },
        "blocked": {
          "type": "string",
          "const": "automatic_candidate_promotion"
        }
      }
    }
  }
}
